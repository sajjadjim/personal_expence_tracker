# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Retrieve these credentials from your Supabase Project Settings -> API
# URL: Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public Key: Safe to expose in the browser client
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Service Role Key (ONLY for server-side administrative tasks, NEVER prefix with NEXT_PUBLIC)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
